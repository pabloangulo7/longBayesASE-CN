{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "longBayesASE-CN parameters",
  "type": "object",
  "definitions": {
    "main": {
      "title": "Run",
      "type": "object",
      "properties": {
        "level": {"type": "string", "enum": ["gene", "isoform"], "default": "gene"},
        "step": {"type": "string", "enum": ["all", "annotation", "dna", "rna", "diffase"], "default": "all"},
        "samplesheet": {"type": "string", "format": "file-path"},
        "fasta": {"type": "string", "format": "file-path"},
        "gff3": {"type": "string", "format": "file-path"},
        "source_fasta": {"type": "string", "format": "file-path"},
        "source_gff3": {"type": "string", "format": "file-path"},
        "contrast": {"type": "string"},
        "isoform_usage": {"type": "string", "format": "file-path"},
        "rna_counts": {"type": "string", "format": "file-path"},
        "copy_number": {"type": "string", "format": "file-path"},
        "counts": {"type": "string", "format": "file-path"},
        "priors": {"type": "string", "format": "file-path"},
        "container_tag": {"type": "string"},
        "outdir": {"type": "string", "default": "results"}
      }
    },
    "optional": {
      "title": "Optional tuning",
      "type": "object",
      "properties": {
        "gene_resolve_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9},
        "isoform_resolve_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9},
        "gene_min_probability": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0},
        "isoform_min_probability": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0},
        "oarfish_score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1.0},
        "oarfish_display_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.001},
        "oarfish_strand": {"type": "string", "enum": ["fw", "rc", "both", ""], "default": "fw"},
        "copy_number_level": {"type": "string", "enum": ["chromosome", "gene"], "default": "chromosome"},
        "cn_change_threshold": {"type": "number", "exclusiveMinimum": 1, "default": 1.2},
        "min_haplotype_depth": {"type": "number", "minimum": 0, "default": 10},
        "min_gene_depth": {"type": "number", "minimum": 0, "default": 1},
        "gene_copies": {"type": "string", "enum": ["all", "primary"], "default": "all"},
        "tiling_read_length": {"type": "integer", "minimum": 1, "default": 1000},
        "tiling_step": {"type": "integer", "minimum": 1, "default": 100},
        "min_simulated_reads": {"type": "integer", "minimum": 1, "default": 1},
        "tiling_max_replicates": {"type": "integer", "minimum": 1, "default": 3},
        "ase_shards": {"type": "integer", "minimum": 1, "default": 100},
        "ase_iterations": {"type": "integer", "minimum": 20, "default": 100000},
        "ase_warmup": {"type": "integer", "minimum": 1, "default": 10000},
        "seed": {"type": "integer", "default": 1701},
        "max_cpus": {"type": "integer", "minimum": 1, "default": 16},
        "max_memory": {"type": "string", "default": "120.GB"},
        "max_time": {"type": "string", "default": "72.h"}
      }
    }
  },
  "allOf": [{"$ref": "#/definitions/main"}, {"$ref": "#/definitions/optional"}]
}
