// Minimal resources for CI and local tests.
//
// The cap keeps every request inside a GitHub runner (4 CPUs, ~15.6 GB), which
// the local executor would otherwise refuse. 8 GB leaves room for the rstan
// compile of process_compile, which the integration job runs for real.
params {
    max_cpus   = 2
    max_memory = '8.GB'
    max_time   = '1.h'
}

process {
    cpus = 1
    memory = 1.GB
    time = 10.m

    withLabel: 'process_low|process_medium|process_high|process_ase' {
        cpus = 1
        memory = 1.GB
        time = 10.m
    }
    // withName outranks withLabel, so the table steps sized by name in
    // nextflow.config have to be lowered by name too.
    withName: 'PREPARE_ASE_INPUT|PREPARE_COMBINED_ASE_INPUT|SPLIT_ASE_INPUT|MERGE_ASE_RESULTS' {
        memory = 1.GB
    }
}
