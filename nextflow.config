manifest {
    name            = 'pabloangulo7/longBayesASE-CN'
    author          = 'Pablo Angulo Lara'
    homePage        = 'https://github.com/pabloangulo7/longBayesASE-CN'
    description     = 'Long-read differential allele-specific expression with mapping-bias and haplotype-specific copy-number correction'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.3.0'
}

params {
    step                         = 'all'
    level                        = 'gene'
    outdir                       = 'results'
    // Image tag for the container profiles. Nextflow 26 cannot resolve
    // manifest.version inside profiles, and CI checks this matches it.
    container_tag                = '0.3.0'
    samplesheet                  = null
    fasta                        = null
    gff3                         = null
    source_fasta                 = null
    source_gff3                  = null
    copy_number                  = null
    priors                       = null
    rna_counts                   = null
    isoform_usage                = null
    counts                       = null
    contrast                     = null

    cn_change_threshold          = 1.2
    min_haplotype_depth          = 10
    min_gene_depth               = 1
    gene_copies                  = 'all'
    copy_number_level            = 'chromosome'

    rna_strand                   = 'fw'
    oarfish_score                = 1.0
    oarfish_bootstraps           = 30

    tiling_read_length           = 1000
    tiling_step                  = 100
    min_simulated_reads          = 1
    tiling_max_replicates        = 3

    ase_shards                   = 100
    ase_iterations               = 100000
    ase_warmup                   = 10000
    seed                         = 1701

    max_cpus                     = 16
    max_memory                   = '120.GB'
    max_time                     = '72.h'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    // Clamp every request to max_cpus, max_memory and max_time. A closure is
    // resolved per task after every config is merged, so a -c config or a
    // profile can still change the limits.
    resourceLimits = {[
        cpus: params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time: params.max_time as nextflow.util.Duration,
    ]}
    // Retry only on the exit codes schedulers use for out-of-memory and walltime
    // kills; any other failure is a real error and stops the run.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] && task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries = 2

    withLabel: process_low {
        cpus = 1
        memory = 4.GB
        time = 2.h
    }
    // Memory and time grow with each attempt, so a retry after a kill asks for more.
    withLabel: process_medium {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withLabel: process_high {
        cpus = 16
        memory = { 64.GB * task.attempt }
        time = { 72.h * task.attempt }
    }
    withLabel: process_ase {
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = 72.h
    }
    withLabel: process_compile {
        cpus = 1
        memory = 7.GB
        time = 2.h
    }

    // Single-core table steps whose memory grows with features x samples.
    withName: 'PREPARE_ASE_INPUT|PREPARE_COMBINED_ASE_INPUT|SPLIT_ASE_INPUT|MERGE_ASE_RESULTS' {
        memory = { 16.GB * task.attempt }
    }

    withName: PREPARE_REFERENCE {
        publishDir = [path: "${params.outdir}/reference", mode: 'copy', overwrite: true, saveAs: { name -> name.tokenize('/').last() }]
    }
    withName: LIFTOFF_ANNOTATE {
        publishDir = [path: "${params.outdir}/reference/liftoff", mode: 'copy', overwrite: true]
    }
    withName: SPLIT_DIPLOID_GFF {
        publishDir = [path: "${params.outdir}/reference", mode: 'copy', overwrite: true]
    }
    withName: BUILD_FEATURE_MAP {
        publishDir = [path: "${params.outdir}/reference", mode: 'copy', overwrite: true, saveAs: { name -> name.tokenize('/').last() }]
    }
    withName: BUILD_ANNOTATION_BUNDLE {
        publishDir = [path: "${params.outdir}/reference", mode: 'copy', overwrite: true, saveAs: { name -> name.tokenize('/').last() }]
    }
    withName: DNA_FEATURE_ASSIGN {
        publishDir = [path: "${params.outdir}/dna/counts", mode: 'copy', overwrite: true, saveAs: { name -> name.endsWith('.bam') ? null : name }]
    }
    withName: DNA_COVERAGE {
        publishDir = [path: "${params.outdir}/dna/coverage", mode: 'copy', overwrite: true]
    }
    withName: COMPUTE_COPY_NUMBER {
        publishDir = [path: "${params.outdir}/dna", mode: 'copy', overwrite: true]
    }
    withName: COPY_NUMBER_FROM_PLOIDY {
        publishDir = [path: "${params.outdir}/dna", mode: 'copy', overwrite: true]
    }
    withName: OARFISH_QUANT {
        publishDir = [path: "${params.outdir}/rna/oarfish", mode: 'copy', overwrite: true]
    }
    withName: RNA_HAPLOTYPE_COUNT {
        publishDir = [path: "${params.outdir}/rna/counts", mode: 'copy', overwrite: true]
    }
    withName: 'MERGE_(RNA|ISOFORM)_COUNTS|MERGE_OARFISH_QUANT' {
        publishDir = [path: "${params.outdir}/rna", mode: 'copy', overwrite: true]
    }
    withName: 'SIM_.*' {
        publishDir = [path: "${params.outdir}/priors/simulation", mode: 'copy', overwrite: true]
    }
    withName: BUILD_MAPPING_PRIORS {
        publishDir = [path: "${params.outdir}/priors", mode: 'copy', overwrite: true]
    }
    withName: PREPARE_ASE_INPUT {
        publishDir = [path: "${params.outdir}/diffase", mode: 'copy', overwrite: true]
    }
    withName: PREPARE_COMBINED_ASE_INPUT {
        publishDir = [path: "${params.outdir}/diffase", mode: 'copy', overwrite: true]
    }
    withName: SPLIT_ASE_INPUT {
        publishDir = [path: "${params.outdir}/diffase/shards", mode: 'copy', overwrite: true, saveAs: { name -> name.tokenize('/').last() }]
    }
    withName: RUN_ASE_SHARD {
        publishDir = [path: "${params.outdir}/diffase/shard_results", mode: 'copy', overwrite: true]
    }
    withName: MERGE_ASE_RESULTS {
        publishDir = [path: "${params.outdir}/diffase", mode: 'copy', overwrite: true]
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

profiles {
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = "ghcr.io/pabloangulo7/longbayesase-cn:${params.container_tag}"
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = "docker://ghcr.io/pabloangulo7/longbayesase-cn:${params.container_tag}"
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

